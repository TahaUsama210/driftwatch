# Component teams may add nested .gitignore files for anything stack-specific.

# Local configuration and secrets (.env.example is the committed template)
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log
npm-debug.log*

# Agent (Go)
/agent/driftwatch-agent
/agent/driftwatch-agent.exe
/agent/dist/
coverage.out
*.test
*.prof

# API (Java)
/api/target/

# Web (Node)
node_modules/
/web/dist/
/web/coverage/
*.tsbuildinfo
.eslintcache
