# Overrides for docker-compose.yml. Copy to .env (git-ignored) and edit; every variable
# is optional and the stack runs with the defaults shown.

# Shared secret agents present on first enrollment; the API requires 24+ characters.
# The default is public and meant only for the local demo: set your own anywhere
# other people can reach the stack.
DRIFTWATCH_ENROLLMENT_TOKEN=insecure-local-demo-token-change-me

# Postgres credentials, used by both the db container and the API.
DB_USER=driftwatch
DB_PASSWORD=driftwatch

# ISO-8601 duration after which a host that has not reported is shown as STALE.
DRIFTWATCH_STALE_AFTER=PT5M

# Go duration between scans on every simulated host.
DRIFTWATCH_INTERVAL=30s

# Seconds between configuration flips on host-alpine-drifting, which generate drift events.
DRIFT_PERIOD=120
