# Rendered at container start by the nginx image's entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only the variables named in NGINX_ENVSUBST_FILTER
# (API_UPSTREAM, DNS_RESOLVER) are substituted; nginx's own $variables are untouched.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Resolve the API per request through Docker's DNS instead of once at startup, so
    # this container starts before the API exists and follows it across restarts.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json
               application/problem+json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Liveness of this container only; it does not touch the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # With a variable in proxy_pass and no URI part, the original request URI is
    # forwarded unchanged (e.g. /api/v1/hosts?page=2).
    location /api/ {
        proxy_pass $api_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Health endpoints only; the rest of /actuator (e.g. prometheus) stays internal.
    location = /actuator/health {
        proxy_pass $api_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /actuator/health/ {
        proxy_pass $api_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /actuator/ {
        return 404;
    }

    # When the API cannot be reached at all, answer in the API's own error format so
    # the dashboard can show a useful message. Errors the API itself returns pass through.
    location @api_unreachable {
        default_type application/problem+json;
        return 502 '{"type":"about:blank","title":"API unreachable","status":502,"detail":"The dashboard could not reach the Driftwatch API. Check that it is running."}';
    }

    # Vite's output is content-hashed, so it can be cached forever. No `always`: a 404
    # (e.g. a chunk from a previous deploy) must not be cached.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The shell must always be revalidated so a deploy is picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Client-side routes (/hosts/<id>, /checks/<id>, ...) all receive the SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
