# Driftwatch agent, installed by Terraform (modules/fleet). See infra/terraform/README.md
# "systemd hardening" for why each directive is (or is not) used.
[Unit]
Description=Driftwatch compliance agent
Documentation=https://github.com/tahausama210/driftwatch/tree/main/agent
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
# "+" runs the token fetch as root outside the sandbox; it writes /run/driftwatch-agent/agent.env.
ExecStartPre=+/usr/local/libexec/driftwatch/write-agent-env
# "-": the file does not exist yet when ExecStartPre itself is spawned. systemd reads it
# again just before ExecStart.
EnvironmentFile=-/run/driftwatch-agent/agent.env
Environment=DRIFTWATCH_SERVER_URL=${server_url}
Environment=DRIFTWATCH_INTERVAL=${interval}
Environment=DRIFTWATCH_STATE_DIR=/var/lib/driftwatch
Environment=DRIFTWATCH_LOG_FORMAT=json
ExecStart=/usr/local/bin/driftwatch-agent run
Restart=on-failure
RestartSec=30s
# The agent gives an in-flight request 5 s after SIGTERM.
TimeoutStopSec=10s

# Identity: a transient unprivileged user instead of root. The single capability
# CAP_DAC_READ_SEARCH lets it read (never write) any file, which is all the checks need:
# /etc/shadow is 0640 root:shadow on Debian/Ubuntu and 0000 on Amazon Linux.
DynamicUser=yes
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
StateDirectory=driftwatch
StateDirectoryMode=0700
UMask=0077

# Filesystem: everything read-only except the state directory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Read-only /proc/sys: kernel parameters stay readable, which the network.* and
# kernel.* checks need.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
PrivateIPC=yes

# Kernel attack surface.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# Deliberately NOT set (each breaks a check):
#   PrivateUsers=yes     host-owned files appear as "nobody" and the capability does not
#                        apply to them, so every owner-uid-0 / shadow check fails
#   ProcSubset=pid       hides /proc/sys, so the network.* and kernel.* checks ERROR
#   PrivateNetwork=yes   the agent would read a private namespace's net.ipv4.* values,
#                        not the host's, and could not reach the API
#   CapabilityBoundingSet= (empty) or dropping CAP_DAC_READ_SEARCH
#                        /etc/shadow becomes unreadable (accounts.* checks ERROR)
#   InaccessiblePaths= / TemporaryFileSystem= over /etc   hides the files being audited

[Install]
WantedBy=multi-user.target
