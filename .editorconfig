# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,go.work}]
indent_style = tab
indent_size = 4

[*.{java,xml}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
