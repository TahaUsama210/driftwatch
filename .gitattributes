# Normalise text to LF in the repository and in every working tree, so shell scripts,
# Dockerfiles and generated files behave the same on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never normalise or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.jar   binary
*.class binary
*.exe   binary

# Generated from contracts/openapi.yaml by `npm run gen:api`; collapsed in diffs.
web/src/api/schema.d.ts linguist-generated=true
