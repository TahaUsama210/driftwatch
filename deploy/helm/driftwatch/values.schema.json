{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Driftwatch control plane values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://[^/]+$",
      "description": "scheme://host[:port], no path or trailing slash"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "description": "At least 24 characters; empty generates one"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "jwksUri": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "webClientId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "staleAfter": {
          "type": "string",
          "pattern": "^P"
        },
        "extraEnv": {
          "type": "array"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "dnsResolver": {
          "type": "string",
          "minLength": 1
        },
        "keycloakUpstream": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "jdbcParameters": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            }
          },
          "required": [
            "namespaceSelector",
            "podSelector"
          ]
        },
        "ingressController": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            }
          },
          "required": [
            "namespaceSelector",
            "podSelector"
          ]
        },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            }
          },
          "required": [
            "namespaceSelector",
            "podSelector"
          ]
        },
        "metricsFrom": {
          "type": "array"
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraIngress": {
              "type": "array"
            },
            "extraEgress": {
              "type": "array"
            }
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraEgress": {
              "type": "array"
            }
          }
        }
      }
    }
  },
  "required": [
    "publicUrl",
    "api",
    "web",
    "keycloak",
    "postgresql",
    "networkPolicy"
  ]
}
