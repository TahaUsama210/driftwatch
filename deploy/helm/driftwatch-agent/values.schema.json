{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Driftwatch agent values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serverUrl": {
      "type": "string",
      "pattern": "^https?://.+"
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interval": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
    },
    "logFormat": {
      "enum": [
        "json",
        "text"
      ]
    },
    "stateHostPath": {
      "type": "string",
      "pattern": "^/.+"
    },
    "mountUsrLib": {
      "type": "boolean"
    },
    "hostMountsRecursiveReadOnly": {
      "enum": [
        "Enabled",
        "IfPossible",
        "Disabled"
      ]
    },
    "hostNetwork": {
      "type": "boolean"
    },
    "tolerations": {
      "type": "array"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "updateStrategy": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            }
          },
          "required": [
            "namespaceSelector",
            "podSelector"
          ]
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object"
                },
                "matchExpressions": {
                  "type": "array"
                }
              }
            }
          },
          "required": [
            "namespaceSelector",
            "podSelector"
          ]
        }
      }
    }
  },
  "required": [
    "image",
    "serverUrl",
    "enrollment"
  ]
}
