{
  "uid": "driftwatch-fleet",
  "title": "Driftwatch fleet compliance",
  "description": "Fleet compliance posture, drift and API health. Alert rules: deploy/observability/prometheus/rules/driftwatch.yml.",
  "tags": [
    "driftwatch",
    "compliance"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "url": "https://github.com/TahaUsama210/driftwatch/blob/main/deploy/observability/RUNBOOK.md"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "driftwatch-prometheus"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "name": "Firing Driftwatch alerts",
        "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Driftwatch.+\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{hostname}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "hostname",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "driftwatch-prometheus"
        },
        "query": {
          "query": "label_values(driftwatch_host_last_seen_timestamp_seconds{job=\"driftwatch-api\"}, hostname)",
          "refId": "hostname"
        },
        "definition": "label_values(driftwatch_host_last_seen_timestamp_seconds{job=\"driftwatch-api\"}, hostname)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fleet average score",
      "description": "Mean latest score across hosts that have one (driftwatch_fleet_average_score). Red below 70, the per-host alert threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "driftwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "driftwatch-prometheus"
          },
          "expr": "driftwatch_fleet_average_score{job=\"driftwatch-api\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 70
              },
              {
                "color": "#0ca30c",
                "value": 90
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
