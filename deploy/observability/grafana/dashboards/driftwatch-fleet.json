    {
      "id": 13,
      "type": "timeseries",
      "title": "Drift events",
      "description": "Fleet-wide drift events per interval. Regressions plot up, resolutions down; CHANGED covers any other status change. Drill into the Driftwatch dashboard (or GET /api/v1/events?direction=REGRESSED) for the hosts and checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "driftwatch-prometheus"
      },
