    {
      "id": 10,
      "type": "table",
      "title": "Hosts failing critical checks",
      "description": "Hosts that would trigger DriftwatchCriticalControlFailing. The host page in the Driftwatch dashboard (or GET /api/v1/hosts/{hostId}) shows which checks fail.",
      "datasource": {
        "type": "prometheus",
        "uid": "driftwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "driftwatch-prometheus"
          },
          "expr": "driftwatch_host_failing_checks{job=\"driftwatch-api\", hostname=~\"$hostname\", severity=\"critical\"} > 0",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No host fails a critical check",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Failing critical checks",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "severity": true
            },
            "indexByName": {
              "hostname": 0,
              "host_id": 1,
              "Value": 2
            },
            "renameByName": {
              "hostname": "Host",
              "host_id": "Host ID",
              "Value": "Failing critical checks"
            }
          }
        }
      ]
    },
